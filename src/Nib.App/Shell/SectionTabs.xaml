<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nib.App.Shell.SectionTabs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nib.App.Shell">

    <!-- Section tabs along the top, like OneNote: a colored edge per section, "+" at the end, the page-list toggle at the far side. -->
    <Grid Height="42" Padding="8,0,8,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ListView x:Name="TabList" Grid.Column="0" SelectionMode="Single" VerticalAlignment="Center"
                  CanReorderItems="True" AllowDrop="True" CanDragItems="True"
                  ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  SelectionChanged="TabList_SelectionChanged" DragItemsCompleted="TabList_DragItemsCompleted"
                  RightTapped="TabList_RightTapped" AutomationProperties.Name="Sections">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,2,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SectionItem">
                    <Grid Padding="14,0,14,0" MinWidth="72" Height="34">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center" Margin="0,0,0,3" />
                        <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" Margin="0,0,0,1" Fill="{x:Bind ColorBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Narrow windows: the tabs collapse into one dropdown showing the current section. -->
        <Button x:Name="CompactButton" Grid.Column="0" Visibility="Collapsed" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                Click="CompactButton_Click" AutomationProperties.Name="Choose section">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Rectangle x:Name="CompactColor" Width="4" Height="18" RadiusX="2" RadiusY="2" />
                <TextBlock x:Name="CompactText" Text="Sections" />
                <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Grid.Column="1" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                Click="AddSection_Click" ToolTipService.ToolTip="New section (Ctrl+T)" AutomationProperties.Name="New section">
            <FontIcon Glyph="&#xE710;" FontSize="13" />
        </Button>

        <ToggleButton x:Name="PagesToggle" Grid.Column="2" Width="34" Height="32" Padding="0" Margin="6,0,0,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                      Click="PagesToggle_Click" ToolTipService.ToolTip="Show or hide the page list" AutomationProperties.Name="Page list">
            <FontIcon Glyph="&#xE8A5;" FontSize="15" />
        </ToggleButton>
    </Grid>
</UserControl>
