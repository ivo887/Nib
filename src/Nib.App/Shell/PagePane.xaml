<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nib.App.Shell.PagePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nib.App.Shell">

    <!-- The page list (right): pages of the open section with subpage indent, a new-page button at the top. -->
    <Grid Background="Transparent" Padding="0,0,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="12,6,6,4">
            <TextBlock x:Name="Heading" Text="Pages" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Height="28" Padding="10,0" Background="Transparent" BorderThickness="0" Click="AddPage_Click"
                    ToolTipService.ToolTip="New page (Ctrl+N)" AutomationProperties.Name="New page">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                    <TextBlock Text="Page" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>

        <ListView x:Name="PageList" Grid.Row="1" SelectionMode="Single"
                  CanReorderItems="True" AllowDrop="True" CanDragItems="True"
                  SelectionChanged="PageList_SelectionChanged" DragItemsCompleted="PageList_DragItemsCompleted"
                  RightTapped="PageList_RightTapped" AutomationProperties.Name="Pages">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PageItem">
                    <Grid Padding="{x:Bind Indent}" MinHeight="36">
                        <TextBlock Text="{x:Bind Title}" Opacity="{x:Bind TitleOpacity}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <FontIcon Glyph="&#xE735;" FontSize="11" HorizontalAlignment="Right" Opacity="0.6" Visibility="{x:Bind FavoriteVisibility}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
