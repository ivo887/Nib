<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Performance suite runner. Launches Nib in perf mode, drives it with synthetic pen, touch and keyboard
    input through the Win32 injection APIs (no special capability needed), collects the app's measurements,
    and fails (exit code 1) if any target in perf/perf-targets.json is missed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Nib.Core\Nib.Core.csproj" />
  </ItemGroup>
</Project>
